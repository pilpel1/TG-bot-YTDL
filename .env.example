BOT_TOKEN=your_bot_token_here

# Telegram API credentials for Local Bot API Server (2GB file support)
# Get these from https://my.telegram.org
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Optional: automatic yt-dlp update (used when running as a systemd service)
# YTDLP_UPDATE_HOUR=1
# YTDLP_UPDATE_MAX_WAIT_HOURS=4
# YTDLP_UPDATE_TIMEZONE=Asia/Jerusalem

# Optional: comma-separated Telegram user IDs for admin commands
# (/status /broadcast /users /mode). Numeric ID, not @username.
# Leave unset = nobody. Never commit the real ID.
# ADMIN_USER_IDS=

# Optional: YouTube channel watch (internal scheduler, not system cron)
# CHANNEL_WATCH_HOURS=8,20
# CHANNEL_WATCH_TIMEZONE=Asia/Jerusalem
# CHANNEL_WATCH_FETCH_LIMIT=20
# CHANNEL_WATCH_MAX_PER_USER=10
 